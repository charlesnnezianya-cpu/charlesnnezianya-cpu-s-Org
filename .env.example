# GEMINI_API_KEY: Required for server-side Gemini AI extraction, OCR, transcription, and summarization.
# Set in Secrets panel; never expose in frontend code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional server-side model override (defaults to gemini-3.1-flash-lite).
GEMINI_MODEL="gemini-3.1-flash-lite"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Required for authentication, database, and file storage)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional server-side Supabase URL (defaults to VITE_SUPABASE_URL if omitted)
SUPABASE_URL="https://your-project-id.supabase.co"
