{
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "public/brainstine-logo.png"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__apiPath=$1"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|src/assets/|.*\\.(?:png|svg|ico|webp|jpg|jpeg|webmanifest|js|css)$).*)",
      "destination": "/index.html"
    }
  ]
}
