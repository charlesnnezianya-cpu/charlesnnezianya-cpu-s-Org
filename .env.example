# GROQ_API_KEY: Primary AI provider key for GroqCloud (openai/gpt-oss-20b)
GROQ_API_KEY="gsk_..."

# GROQ_API_KEY_2: Secondary Groq API key for failover
GROQ_API_KEY_2="gsk_..."

# GROQ_API_KEY_3: Tertiary Groq API key for failover
GROQ_API_KEY_3="gsk_..."

# GEMINI_API_KEY: Required for server-side Gemini AI extraction, OCR, transcription, and final fallback.
# Set in Secrets panel; never expose in frontend code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NANO_BANANA_API_KEY: Optional paid Gemini API key for Nano Banana 2.1 educational summary visuals.
# When omitted, visual generation is safely skipped and text summaries render normally.
NANO_BANANA_API_KEY=""

# GEMINI_MODEL: Permanent AI model across all Brainstine features (locked to gemini-3.1-flash-lite).
GEMINI_MODEL="gemini-3.1-flash-lite"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Required for authentication, database, and file storage)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional server-side Supabase URL (defaults to VITE_SUPABASE_URL if omitted)
SUPABASE_URL="https://your-project-id.supabase.co"

# Persistent server-side secret (>= 16 characters) for encrypting quiz and exam answer keys.
# Set a strong random string in Secrets; never expose to the browser or prefix with VITE_.
ASSESSMENT_KEY_SECRET=""
